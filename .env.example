# ─── Required ───────────────────────────────────────────
# Telegram Bot Token (get from @BotFather)
TELEGRAM_BOT_TOKEN=your_token_here

# Comma-separated Telegram user IDs allowed to use the bot
# Get yours from @userinfobot
# The bot REFUSES to start if this is empty.
TELEGRAM_ALLOWED_USER_ID=123456789

# ─── Optional ───────────────────────────────────────────
# Working directory for the MiMoCode agent (default: current dir).
# The bot spawns `mimo serve` with this as its cwd.
# MIMO_WORK_DIR=/root

# Connect to an existing MiMoCode server instead of spawning one.
# Useful when a server is already running: `mimo serve --port 4096`
# MIMO_API_URL=http://127.0.0.1:4096

# Port for the bot-managed `mimo serve` (ignored when MIMO_API_URL is set).
# MIMO_SERVE_PORT=4096

# Permission handling:
#   false (default) — permission requests are forwarded to Telegram as
#                     inline buttons (✅ once / ⚡ always / ❌ reject)
#   true            — every permission request is auto-approved (equivalent to
#                     --dangerously-skip-permissions). DANGER: anyone on the
#                     whitelist can make the agent run arbitrary commands and
#                     read/write files unattended. Leave false unless this
#                     host is fully disposable/trusted.
MIMO_SKIP_PERMISSIONS=false

# Wall-clock timeout (milliseconds) for a single message exchange. Guards
# against hung runs (provider stalls, infinite loops). 0 disables the
# timeout. Default 300000 (5 minutes).
# MIMO_RUN_TIMEOUT_MS=300000

# Path to the `mimo` CLI executable. Set to the full path (e.g.
# /usr/local/bin/mimo) when the runtime environment does not inherit the
# expected PATH — common with systemd, tmux/nohup, and Bun subprocess spawns.
# Defaults to "mimo" (relies on PATH resolution).
# MIMO_CLI_PATH=mimo

# Control which MiMoCode event types appear as Telegram messages.
# Values: full (complete content), brief (one-line summary),
#         hint (placeholder only, e.g. "正在思考..."), off (silent)
# MIMO_SHOW_TEXT=full
# MIMO_SHOW_REASONING=off
# MIMO_SHOW_TOOL_USE=off
# MIMO_SHOW_STEP_START=off
# MIMO_SHOW_STEP_FINISH=off

# ─── MimoCode server env (passed through to `mimo serve`) ──
# Secures a non-loopback bind. Loopback (default) needs no password.
# MIMOCODE_SERVER_PASSWORD=
